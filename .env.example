# Application Environment
NODE_ENV=production
PORT=5003
HOST=0.0.0.0

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-url>/<database>?retryWrites=true&w=majority
DB_NAME=FPH


# JWT Configuration
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-unique-secret-at-least-32-characters
SESSION_SECRET=replace-with-a-unique-session-secret-at-least-32-characters


# HTTPS/SSL Configuration
USE_HTTPS=false

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Face Recognition Configuration
FACE_API_MODEL_PATH=./models/face-api-models/
FACE_DETECTION_CONFIDENCE=0.5
FACE_MATCHING_THRESHOLD=0.6

# CORS Configuration
# Prefer `ALLOWED_ORIGINS` (comma-separated). `CORS_ORIGIN` is supported for legacy deployments.
ALLOWED_ORIGINS=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_key
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15m

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Email — Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Future Property Holdings <onboarding@resend.dev>

# SMS — Africa's Talking (https://africastalking.com)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_africastalking_username

# Admin Bootstrap (used by scripts/create-admin.js)
MASTER_KEY=choose_a_strong_secret_at_least_32_chars

# Creator account (local development and production seed)
CREATOR_EMAIL=admin@example.com
CREATOR_PASSWORD=replace-with-a-strong-password
CREATOR_FIRST_NAME=Admin
CREATOR_LAST_NAME=User

# App URL (used in email links)
APP_URL=https://futurepropertyholdings.vercel.app

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# API Configuration
API_VERSION=v1
API_BASE_URL=https://futurepropertyholdings.vercel.app
