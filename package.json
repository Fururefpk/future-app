{
  "name": "future-property-holdings",
  "version": "1.0.0",
  "description": "Ghana property rental platform with verified identity",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "check:env": "node scripts/validate-env.js",
    "start:prod": "NODE_ENV=production node server.js",
    "db:status": "node scripts/db-status.js",
    "db:seed": "node scripts/seed-demo.js",
    "smoke": "node scripts/smoke-test.js",
    "perf": "node scripts/measure-api.js",
    "check": "npm run check:env && npm test && npm audit --omit=dev",
    "vercel-build": "echo 'No build step — static frontend'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "resend": "^6.28.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}